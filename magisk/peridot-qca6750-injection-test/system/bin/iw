#!/bin/sh
# Universal iw wrapper for Qualcomm monitor mode channel control & Stryker compatibility
# Intercepts:
#   iw dev <iface> set channel <ch> [HT20|...]
#   iw dev <iface> set type monitor | managed
#   iw dev / iw <iface> info (synthesizes type monitor when in monitor mode)
#   iw dev <iface> scan (dumps kernel BSS cache for fast, reliable scan results on Android)

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH

IFACE="wlan0"
CH=""
IS_SET_CHAN=0
IS_SCAN=0
IS_DUMP=0

prev=""
for arg in "$@"; do
	case "$arg" in
		wlan*|mon*) IFACE="$arg" ;;
	esac
	if [ "$prev" = "channel" ] || [ "$prev" = "freq" ]; then
		CH="$arg"
		IS_SET_CHAN=1
	fi
	if [ "$arg" = "scan" ]; then
		IS_SCAN=1
	fi
	if [ "$arg" = "dump" ]; then
		IS_DUMP=1
	fi
	prev="$arg"
done

# 1. Intercept channel switching
if [ "$IS_SET_CHAN" -eq 1 ] && [ -n "$CH" ]; then
	CLEAN_CH=$(echo "$CH" | sed 's/[GgMm]//g')
	SYSFS="/sys/class/net/$IFACE/monitor_mode_channel"
	[ ! -e "$SYSFS" ] && SYSFS="/sys/class/net/wlan0/monitor_mode_channel"
	if [ -e "$SYSFS" ]; then
		echo "$CLEAN_CH 0" > "$SYSFS" 2>/dev/null
	fi
	exit 0
fi

# 2. Intercept mode switching (e.g. from Stryker GUI)
if [ "$1" = "dev" ] && [ "$3" = "set" ] && [ "$4" = "type" ]; then
	TARGET_TYPE="$5"
	PWM_BIN="/data/adb/modules/peridot-qca6750-injection-test/system/bin/peridot-wlan-mode"
	[ -x "$PWM_BIN" ] || PWM_BIN="/system/bin/peridot-wlan-mode"
	[ -x "$PWM_BIN" ] || PWM_BIN="/usr/bin/peridot-wlan-mode"

	if [ "$TARGET_TYPE" = "monitor" ]; then
		CUR_MODE=$(cat /sys/module/qca_cld3_qca6750/parameters/con_mode 2>/dev/null)
		if [ "$CUR_MODE" != "4" ] && [ -x "$PWM_BIN" ]; then
			"$PWM_BIN" monitor >/dev/null 2>&1 || true
		fi
		exit 0
	elif [ "$TARGET_TYPE" = "managed" ]; then
		CUR_MODE=$(cat /sys/module/qca_cld3_qca6750/parameters/con_mode 2>/dev/null)
		if [ "$CUR_MODE" != "0" ] && [ -x "$PWM_BIN" ]; then
			"$PWM_BIN" managed >/dev/null 2>&1 || true
		fi
		exit 0
	fi
fi

# Helper to invoke the underlying real iw binary
get_real_iw_output() {
	if [ -x "/usr/sbin/iw.real" ]; then
		/usr/sbin/iw.real "$@" 2>/dev/null
	elif [ -x "/data/local/stryker/release/usr/sbin/iw.real" ]; then
		chroot /data/local/stryker/release /usr/sbin/iw.real "$@" 2>/dev/null
	elif [ -x "/data/local/stryker/release/usr/sbin/iw" ] && ! head -n 1 "/data/local/stryker/release/usr/sbin/iw" 2>/dev/null | grep -q "^#"; then
		chroot /data/local/stryker/release /usr/sbin/iw "$@" 2>/dev/null
	elif [ -f /data/data/com.termux/files/usr/lib/libnl-3.so ] && [ -x /data/data/com.termux/files/usr/bin/iw ]; then
		LD_LIBRARY_PATH=/data/data/com.termux/files/usr/lib /data/data/com.termux/files/usr/bin/iw "$@" 2>/dev/null
	else
		return 1
	fi
}

# 3. Intercept scan requests for Stryker & nl80211 on Android
# On Android, 'iw dev <iface> scan' fails with -105 (ENOBUFS) because wificond locks scanning.
# Dumping the kernel BSS cache via 'iw dev <iface> scan dump' returns all scanned networks instantly.
if [ "$IS_SCAN" -eq 1 ]; then
	if [ "$IS_DUMP" -eq 1 ]; then
		if [ -x "/usr/sbin/iw.real" ]; then
			exec /usr/sbin/iw.real "$@"
		else
			get_real_iw_output "$@"
			exit 0
		fi
	fi

	# First try scan dump from the kernel BSS cache
	DUMP_OUT=$(get_real_iw_output dev "$IFACE" scan dump)
	if echo "$DUMP_OUT" | grep -q "BSS "; then
		echo "$DUMP_OUT"
		exit 0
	fi

	# If dump is empty, try active scan trigger
	SCAN_OUT=$(get_real_iw_output "$@")
	if echo "$SCAN_OUT" | grep -q "BSS "; then
		echo "$SCAN_OUT"
		exit 0
	fi

	# If both were empty, sleep briefly for ongoing scan and dump again
	sleep 1
	get_real_iw_output dev "$IFACE" scan dump
	exit 0
fi

# 4. Intercept interface inspection (iw dev / iw <iface> info)
IS_MON=0
if [ -r /sys/module/qca_cld3_qca6750/parameters/con_mode ] && [ "$(cat /sys/module/qca_cld3_qca6750/parameters/con_mode 2>/dev/null)" = "4" ]; then
	IS_MON=1
fi

if [ "$1" = "dev" ] && [ -z "$2" ]; then
	RAW_OUT=$(get_real_iw_output "$@")
	if [ -n "$RAW_OUT" ]; then
		if [ "$IS_MON" -eq 1 ]; then
			echo "$RAW_OUT" | sed 's/type managed/type monitor/g'
		else
			echo "$RAW_OUT"
		fi
		exit 0
	elif [ "$IS_MON" -eq 1 ]; then
		MAC=$(cat /sys/class/net/wlan0/address 2>/dev/null || echo "00:11:22:33:44:55")
		cat << EOF
phy#1
	Interface wlan0
		ifindex 30
		wdev 0x1
		addr $MAC
		type monitor
		txpower 20.00 dBm
EOF
		exit 0
	fi
fi

if [ "$2" = "info" ] || [ "$1" = "info" ]; then
	RAW_OUT=$(get_real_iw_output "$@")
	if [ -n "$RAW_OUT" ]; then
		if [ "$IS_MON" -eq 1 ]; then
			echo "$RAW_OUT" | sed 's/type managed/type monitor/g'
		else
			echo "$RAW_OUT"
		fi
		exit 0
	fi
fi

# 5. Fallback execution for other queries
if [ -x "/usr/sbin/iw.real" ]; then
	exec /usr/sbin/iw.real "$@"
elif [ -x "/data/local/stryker/release/usr/sbin/iw.real" ]; then
	exec chroot /data/local/stryker/release /usr/sbin/iw.real "$@"
elif [ -f /data/data/com.termux/files/usr/lib/libnl-3.so ] && [ -x /data/data/com.termux/files/usr/bin/iw ]; then
	LD_LIBRARY_PATH=/data/data/com.termux/files/usr/lib exec /data/data/com.termux/files/usr/bin/iw "$@"
fi

exit 0
