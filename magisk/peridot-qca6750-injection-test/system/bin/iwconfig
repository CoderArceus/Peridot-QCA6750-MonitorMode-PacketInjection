#!/bin/sh
# Universal iwconfig wrapper for Qualcomm monitor mode channel control
# Automatically intercepts:
#   iwconfig <iface> channel <ch>
#   iwconfig <iface> freq <freq>
# and writes to /sys/class/net/<iface>/monitor_mode_channel

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH

IFACE="${1:-wlan0}"
CH=""
IS_SET_CHAN=0

prev=""
for arg in "$@"; do
	if [ "$prev" = "channel" ] || [ "$prev" = "freq" ]; then
		CH="$arg"
		IS_SET_CHAN=1
	fi
	prev="$arg"
done

if [ "$IS_SET_CHAN" -eq 1 ] && [ -n "$CH" ]; then
	CLEAN_CH=$(echo "$CH" | sed 's/[GgMm]//g')
	SYSFS="/sys/class/net/$IFACE/monitor_mode_channel"
	[ ! -e "$SYSFS" ] && SYSFS="/sys/class/net/wlan0/monitor_mode_channel"
	if [ -e "$SYSFS" ]; then
		echo "$CLEAN_CH 0" > "$SYSFS" 2>/dev/null
	fi
	exit 0
fi

# Fallback to real iwconfig if available
if [ -x "/system/bin/iwconfig" ] && [ "/system/bin/iwconfig" != "$0" ]; then
	exec /system/bin/iwconfig "$@"
elif [ -f /data/data/com.termux/files/usr/lib/libwireless.so ] && [ -x /data/data/com.termux/files/usr/bin/iwconfig ]; then
	exec /data/data/com.termux/files/usr/bin/iwconfig "$@"
fi

exit 0
